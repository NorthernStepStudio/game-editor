{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Matterhorn Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/out/**/*.js"
      ],
      "preLaunchTask": "compile:extension"
    },
    {
      "name": "Matterhorn Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/out/index.js",
      "cwd": "${workspaceFolder}",
      "outFiles": [
        "${workspaceFolder}/server/out/**/*.js"
      ],
      "preLaunchTask": "compile:server",
      "console": "internalConsole"
    }
  ],
  "compounds": [
    {
      "name": "Matterhorn (Full)",
      "configurations": [
        "Matterhorn Server",
        "Matterhorn Extension"
      ]
    }
  ]
}
